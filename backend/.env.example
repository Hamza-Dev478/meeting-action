# Copy to backend/.env (git-ignored) and adjust. Never commit real keys.

# AI provider: "fake" (deterministic, no secrets, default) or "anthropic".
AI_PROVIDER=fake

# Only needed when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional overrides for the real adapter.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_TIMEOUT_SECONDS=25

# Fake provider behaviour for demos: heuristic | malformed | timeout | error | slow
# (append _once, e.g. timeout_once, to fail a single attempt then recover).
# Prefer `bin/rails "ai:fake_mode[timeout_once]"`, which needs no restart.
# FAKE_AI_MODE=heuristic

# Optional PostgreSQL connection override (defaults to the local socket).
# DATABASE_URL=postgres://localhost/meeting_action_development
